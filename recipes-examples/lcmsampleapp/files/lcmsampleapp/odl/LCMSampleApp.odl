#!/usr/bin/amxrt

%config {
    // Application name
    name = "LCMSampleApp";

    // amxo parser config-options
    import-dbg = false;

    // amxrt config-options
    auto-detect = true;
    auto-connect = true;
    //daemon = false;
    priority = 0;
    pid-file = true;

    // bus specific configuration
    pcb = {
        register-name = "${name}"
    };

    sahtrace = {
        type = "stdout",
        level = 500
    };

    trace-zones = ["main", "methods"];

    // Application specific settings
    // persistent storage location
    rw_data_path = "${prefix}/etc/config";

    // main files
    definition_file = "definition.odl";
    save_file = "${rw_data_path}/${name}/${name}.odl";
    defaults_file = "defaults.odl";
}

import "${name}.so" as "${name}";

include "${definition_file}";
?include "${save_file}":"${defaults_file}";
#include "mod_sahtrace.odl";

%define {
    entry-point LCMSampleApp.lcm_sample_app_main;
}
